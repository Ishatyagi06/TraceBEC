# ==============================================================================
# phisGuard / TraceBEC - Git Ignore Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
include/
lib/
lib64/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
htmlcov/
.hypothesis/
.tox/

# Distribution & Packaging
build/
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# Node.js & Frontend (Vite, React, TypeScript)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
**/dist/
**/dist-ssr/
.vite/
**/.vite/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Linting & Type Checking Caches
.eslintcache
.oxlintcache
.tsbuildinfo
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Machine Learning & Model Checkpoints
# ------------------------------------------------------------------------------
.cache/
**/.cache/
checkpoints/
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.joblib
*.pkl

# ------------------------------------------------------------------------------
# Environment Variables & Sensitive Credentials
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.cert
*.crt
credentials.json
token.json

# ------------------------------------------------------------------------------
# Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini

# Editors & IDEs
.idea/
*.swp
*.swo
*~
*.bak
*.sublime-project
*.sublime-workspace

# VS Code (preserve shared launch/tasks if desired, ignore local state)
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.vscode/*.log
